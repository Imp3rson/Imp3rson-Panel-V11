----------------------------------------------------------------
-- SPIDER (sobe paredes automaticamente ao encostar)
----------------------------------------------------------------
local spiderConnection
local spiderForce

local function setSpider(enabled)
    State.spider = enabled
    if spiderConnection then spiderConnection:Disconnect(); spiderConnection = nil end

    if not enabled then
        local hrp = getHRP()
        if hrp then
            local sf = hrp:FindFirstChild("SpiderForce")
            if sf then sf:Destroy() end
        end
        spiderForce = nil
        notify("🕷️ Spider desativado", Color3.fromRGB(150, 150, 150))
        return
    end

    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude

    spiderConnection = RunService.Heartbeat:Connect(function()
        local char = getChar()
        local hrp = getHRP()
        local hum = getHum()
        if not char or not hrp or not hum then return end

        -- Atualiza o filtro (exclui o próprio personagem)
        params.FilterDescendantsInstances = { char }

        -- Cria/reutiliza o BodyVelocity
        if not spiderForce or spiderForce.Parent ~= hrp then
            if spiderForce then spiderForce:Destroy() end
            spiderForce = Instance.new("BodyVelocity")
            spiderForce.Name = "SpiderForce"
            spiderForce.MaxForce = Vector3.new(1e5, 1e5, 1e5)
            spiderForce.Velocity = Vector3.zero
            spiderForce.Parent = hrp
        end

        -- 🔍 Raycast nas 4 direções (frente, trás, esquerda, direita)
        local origin = hrp.Position
        local dirs = {
            hrp.CFrame.LookVector,
            -hrp.CFrame.LookVector,
            hrp.CFrame.RightVector,
            -hrp.CFrame.RightVector,
        }

        local touchingWall = false
        for _, dir in ipairs(dirs) do
            -- Ignora componente vertical (só paredes, não chão/teto)
            local horizontalDir = Vector3.new(dir.X, 0, dir.Z)
            if horizontalDir.Magnitude > 0 then
                horizontalDir = horizontalDir.Unit
                local result = workspace:Raycast(origin, horizontalDir * 3.5, params)
                if result and result.Instance then
                    -- Confirma que é parede (normal quase horizontal)
                    local normal = result.Normal
                    if math.abs(normal.Y) < 0.7 then
                        touchingWall = true
                        break
                    end
                end
            end
        end

        -- 🧗 Se tá encostado em parede → sobe
        if touchingWall then
            spiderForce.Velocity = Vector3.new(0, 35, 0)
            -- Força o estado Freefall pra não "grudar" no chão
            if hum.FloorMaterial ~= Enum.Material.Air then
                hum:ChangeState(Enum.HumanoidStateType.Freefall)
            end
        else
            spiderForce.Velocity = Vector3.zero
        end
    end)

    notify("🕷️ Spider ativado — encoste na parede", CONFIG.GREEN)
end

----------------------------------------------------------------
-- GRAVITY (corrigida — não trava mais)
----------------------------------------------------------------
local function setGravity(enabled)
    State.gravity = enabled
    local hum = getHum()
    if enabled then
        -- Nunca deixa a gravidade menor que 20 (evita personagem flutuando travado)
        local g = State.gravityValue
        if g < 20 then g = 20 end
        workspace.Gravity = g
        -- Reseta a velocidade vertical pra não travar
        local hrp = getHRP()
        if hrp then
            hrp.Velocity = Vector3.new(hrp.Velocity.X, 0, hrp.Velocity.Z)
        end
        if hum then
            hum:ChangeState(Enum.HumanoidStateType.Freefall)
        end
        notify("🌀 Gravity = " .. g, CONFIG.GREEN)
    else
        workspace.Gravity = State.defaultGravity
        notify("🌀 Gravity restaurada", Color3.fromRGB(150, 150, 150))
    end
end

