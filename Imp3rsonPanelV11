local function createFloatingButton()
    if CoreGui:FindFirstChild("Imp3rsonFloat") then return end
    local g = Instance.new("ScreenGui")
    g.Name = "Imp3rsonFloat"
    g.ResetOnSpawn = false
    g.IgnoreGuiInset = true
    g.DisplayOrder = 99
    g.Parent = CoreGui

    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(0, CONFIG.FLOAT_SIZE, 0, CONFIG.FLOAT_SIZE)
    btn.Position = CONFIG.FLOAT_POS
    btn.BackgroundColor3 = CONFIG.ACCENT
    btn.BorderSizePixel = 0
    btn.Text = "💠"
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn.Font = Enum.Font.GothamBold
    btn.TextSize = 26
    btn.AutoButtonColor = false
    btn.Parent = g
    Instance.new("UICorner", btn).CornerRadius = UDim.new(1, 0)
    local s = Instance.new("UIStroke")
    s.Color = CONFIG.ACCENT_BRIGHT; s.Thickness = 2; s.Parent = btn

    local dragging, dragStart, startPos
    btn.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.Touch then
            dragging = true; dragStart = input.Position; startPos = btn.Position
        end
    end)
    btn.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
            if dragStart then
                local d = input.Position - dragStart
                if math.abs(d.X) < 10 and math.abs(d.Y) < 10 then
                    setHubVisibility(not State.hubOpen)
                end
            end
            dragStart = nil
        end
    end)
    btn.InputChanged:Connect(function(input)
        if not dragging then return end
        if input.UserInputType == Enum.UserInputType.Touch then
            local d = input.Position - dragStart
            btn.Position = UDim2.new(
                startPos.X.Scale, startPos.X.Offset + d.X,
                startPos.Y.Scale, startPos.Y.Offset + d.Y)
        end
    end)
end

