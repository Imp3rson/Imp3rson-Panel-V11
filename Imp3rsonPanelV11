local function setFly(enabled)
    State.fly = enabled
    if flyConnection then flyConnection:Disconnect(); flyConnection = nil end

    if not enabled then
        if flyGui then flyGui:Destroy(); flyGui = nil end
        flyUpDown.up = false
        flyUpDown.down = false
        local hrp = getHRP()
        if hrp then
            hrp.Velocity = Vector3.zero
            local bv = hrp:FindFirstChild("ImpFlyVel")
            if bv then bv:Destroy() end
            local bg = hrp:FindFirstChild("ImpFlyGyro")
            if bg then bg:Destroy() end
        end
        local hum = getHum()
        if hum then hum.PlatformStand = false end
        return
    end

    createFlyUpDownButtons()

    local bodyGyro, bodyVel
    flyConnection = RunService.RenderStepped:Connect(function()
        local hrp = getHRP()
        local hum = getHum()
        if not hrp then return end

        if not bodyVel or bodyVel.Parent ~= hrp then
            if bodyVel then bodyVel:Destroy() end
            if bodyGyro then bodyGyro:Destroy() end
            bodyVel = Instance.new("BodyVelocity")
            bodyVel.Name = "ImpFlyVel"
            bodyVel.MaxForce = Vector3.new(1e5, 1e5, 1e5)
            bodyVel.Velocity = Vector3.zero
            bodyVel.Parent = hrp
            bodyGyro = Instance.new("BodyGyro")
            bodyGyro.Name = "ImpFlyGyro"
            bodyGyro.MaxTorque = Vector3.new(1e5, 1e5, 1e5)
            bodyGyro.P = 1000
            bodyGyro.Parent = hrp
        end

        local cam = workspace.CurrentCamera
        local speed = State.flySpeed
        local moveVec = Vector3.zero

        -- 🎮 JOYSTICK MOBILE (lê a direção do humanoid)
        if hum and hum.MoveDirection.Magnitude > 0 then
            local md = hum.MoveDirection
            -- MoveDirection já vem em world space, então usamos direto
            moveVec += md
        end

        -- ⌨️ TECLADO (PC)
        local camForward = Vector3.new(cam.CFrame.LookVector.X, 0, cam.CFrame.LookVector.Z)
        local camRight   = Vector3.new(cam.CFrame.RightVector.X, 0, cam.CFrame.RightVector.Z)
        if camForward.Magnitude > 0 then camForward = camForward.Unit end
        if camRight.Magnitude > 0 then camRight = camRight.Unit end

        if UIS:IsKeyDown(Enum.KeyCode.W) then moveVec += camForward end
        if UIS:IsKeyDown(Enum.KeyCode.S) then moveVec -= camForward end
        if UIS:IsKeyDown(Enum.KeyCode.A) then moveVec -= camRight end
        if UIS:IsKeyDown(Enum.KeyCode.D) then moveVec += camRight end

        -- 🔼🔽 SUBIR/DESCER
        local vertical = 0
        if UIS:IsKeyDown(Enum.KeyCode.Space) or flyUpDown.up then vertical += 1 end
        if UIS:IsKeyDown(Enum.KeyCode.LeftShift) or flyUpDown.down then vertical -= 1 end
        moveVec += Vector3.new(0, vertical, 0)

        if moveVec.Magnitude > 0 then
            bodyVel.Velocity = moveVec.Unit * speed
        else
            bodyVel.Velocity = Vector3.zero
        end

        bodyGyro.CFrame = cam.CFrame
    end)

    notify("🛫 Fly ativado — use o joystick", CONFIG.GREEN)
end

